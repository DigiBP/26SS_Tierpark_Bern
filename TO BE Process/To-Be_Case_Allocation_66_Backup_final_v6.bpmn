    <bpmn:serviceTask id="Activity_14u7zn5" name="Calculate Distances and Score">
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="url">https://hook.eu1.make.com/bt9nyzo32v36y1ggdxchum4qbojxvluk</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="Content-Type">application/json</camunda:inputParameter>
            <camunda:inputParameter name="payload">
              <camunda:script scriptFormat="javascript">JSON.stringify({
  caseId: execution.getVariable("caseId"),
  firstName: execution.getVariable("firstName"),
  lastName: execution.getVariable("lastName"),
  address: execution.getVariable("address"),
  city: execution.getVariable("city"),
  postalCode: execution.getVariable("postalCode"),
  mainLanguage: execution.getVariable("mainLanguage"),
  otherLanguage: execution.getVariable("otherLanguage"),
  urgency: execution.getVariable("urgency"),
  caseType: execution.getVariable("caseType"),
  workload: execution.getVariable("workload")
});</camunda:script>
            </camunda:inputParameter>
            <camunda:outputParameter name="makeResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03ukijq</bpmn:incoming>
      <bpmn:outgoing>Flow_0vz8xaf</bpmn:outgoing>
